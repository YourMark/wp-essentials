{
    "name": "yourmark/wp-essentials",
    "description": "Hardening, cleanup and a client administrator role for every WordPress site, as a must-use or regular plugin.",
    "type": "wordpress-muplugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "yourmark/coding-standards": "^1.0"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/YourMark/coding-standards" }
    ],
    "extra": {
        "installer-name": "yourmark-essentials"
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "qa": ["@phpcs", "@phpstan"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
